{
  "name": "emailai-electron",
  "version": "1.2.0",
  "description": "eMail-IA Desktop App (Electron wrapper)",
  "author": "Santiago Pérez Gómez <SantiPG-Dev@gmx.com>",
  "homepage": "https://github.com/santipg/eMail-IA",
  "main": "dist/main.js",
  "scripts": {
    "build": "npx tsc",
    "start": "npm install --silent && npx tsc && electron dist/main.js",
    "dev": "npx tsc && electron dist/main.js",
    "dist": "bash build-jre.sh && npx tsc && electron-builder",
    "dist:linux": "bash build-jre.sh && npx tsc && electron-builder --linux",
    "dist:dir": "npx tsc && electron-builder --dir",
    "dist:rpm": "bash build-jre.sh && bash ../lanzadores/linux/deb-rpm/build-rpm.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
