# =========================
# eMail-IA — Monorepo .gitignore
# =========================

# --- Java / Backend ---
backend/target/
*.class
*.jar
!backend/**/*.jar
*.war

# --- Node.js / Frontend / Electron ---
node_modules/
frontend/dist/
frontend/node_modules/
electron/dist/
electron/out/
electron/node_modules/
*.tsbuildinfo

# --- Vite ---
*.local

# --- Electron builder ---
electron/release/
electron-builder-cache/

# --- Archivos de datos locales (H2 cifrada, modelos Weka, JWT key) ---
*.mv.db
*.trace.db
**/jwt.key

# --- Secretos (OAuth credentials, no commitear) ---
electron/oauth-config.json
*.env.local
emailAI.db
*.model
DB/
.eMailAI/

# --- Logs ---
*.log
logs/

# --- Security audit (no se commitea) ---
SecurityAudit.md

# --- Entorno ---
.env
.env.local
.env.*.local

# --- IDE ---
.metadata/
.vscode/
*.iml
.classpath
.project
.settings/
# .idea/ se mantiene versionado (config IntelliJ compartida)

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
frontend/pnpm-workspace.yaml
electron/node_modules
electron/dist
# Config runtime (anclado: un "config/" a secas ignoraba el paquete fuente
# backend/src/main/java/com/emailai/config)
/config/
backend/config/

# ------ Mis cosas --------
ToDo.md
CHECKLIST-1.0.md

# Backups de BD creados al resetear para testing
DB.backup-*/
