# =========================
# eMail-IA — Monorepo .gitignore
# =========================

# --- Java / Backend ---
backend/target/
*.class
*.jar
!backend/**/*.jar

# --- Node.js / Frontend / Electron ---
node_modules/
frontend/dist/
electron/dist/
*.tsbuildinfo

# --- Vite ---
*.local

# --- Electron builder ---
electron/release/
electron/jre/

# --- Archivos de datos locales (H2 cifrada, modelos Weka, JWT key) ---
*.mv.db
*.trace.db
**/jwt.key

# --- Secretos (OAuth credentials, no commitear) ---
electron/oauth-config.json
*.model
DB/

# --- Logs ---
*.log
logs/

# --- Entorno ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.iml
.classpath
.project
.settings/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
frontend/pnpm-workspace.yaml

# Config runtime (anclado: un "config/" a secas ignoraba el paquete fuente
# backend/src/main/java/com/emailai/config)
/config/
backend/config/

# ------ Mis cosas --------
Review ToDo.md

# Backups de BD creados al resetear para testing
DB.backup-*/

